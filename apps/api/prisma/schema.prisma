generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberType {
  owner
  adult
  child
  helper
}

/// Семейная роль (не путать с правами MemberType)
enum MemberRelation {
  mother
  father
  daughter
  son
  grandmother
  grandfather
  nanny
  other
}

enum EventStatus {
  active
  cancelled
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum NotificationType {
  reminder
  event_updated
  event_cancelled
}

model User {
  id           String   @id @default(cuid())
  /// Логин для входа (обязательный)
  login        String   @unique
  /// Email необязателен (рассылок нет)
  email        String?  @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedFamilies Family[]
  members       FamilyMember[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  invitationsCreated Invitation[] @relation("InvitationCreator")
  invitationsAccepted Invitation[] @relation("InvitationAcceptor")
  notifications Notification[]
  pushSubscriptions PushSubscription[]
}

model Family {
  id                   String   @id @default(cuid())
  name                 String
  ownerId              String
  travelBufferDefault  Int      @default(15)
  timezone             String   @default("Europe/Moscow")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  owner      User           @relation(fields: [ownerId], references: [id])
  members    FamilyMember[]
  events     Event[]
  categories Category[]
  invitations Invitation[]
}

model FamilyMember {
  id        String          @id @default(cuid())
  familyId  String
  userId    String?
  name      String
  color     String
  type      MemberType
  relation  MemberRelation  @default(other)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  family            Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id])
  participations    EventParticipant[]
  responsibleEvents Event[]            @relation("EventResponsible")
  claimInvitations  Invitation[]

  @@index([familyId])
  @@index([userId])
  @@unique([familyId, userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, usedAt])
}

model Invitation {
  id               String           @id @default(cuid())
  familyId         String
  token            String           @unique
  code             String           @unique
  memberType       MemberType       @default(adult)
  invitedName      String?
  invitedEmail     String?
  color            String           @default("#0D9488")
  /// Если задан — принять приглашение привяжет аккаунт к этому участнику (без дубля)
  targetMemberId   String?
  createdById      String
  status           InvitationStatus @default(pending)
  expiresAt        DateTime
  acceptedByUserId String?
  acceptedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("InvitationCreator", fields: [createdById], references: [id])
  acceptedBy   User?         @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id])
  targetMember FamilyMember? @relation(fields: [targetMemberId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([code])
  @@index([familyId, status, expiresAt])
  @@index([targetMemberId])
}

model Category {
  id        String   @id @default(cuid())
  familyId  String
  name      String
  color     String   @default("#5B6F64")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  events Event[]

  @@index([familyId])
  @@unique([familyId, name])
}

model Event {
  id                  String      @id @default(cuid())
  familyId            String
  title               String
  description         String?
  startsAtUtc         DateTime
  endsAtUtc           DateTime
  timezone            String
  location            String?
  categoryId          String
  responsibleMemberId String?
  travelBufferMinutes Int?
  /// RRULE string, e.g. FREQ=WEEKLY;BYDAY=MO,WE;UNTIL=20261231T235959Z
  recurrenceRule      String?
  status              EventStatus @default(active)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  family       Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category     Category           @relation(fields: [categoryId], references: [id])
  responsible  FamilyMember?      @relation("EventResponsible", fields: [responsibleMemberId], references: [id], onDelete: SetNull)
  participants EventParticipant[]
  exceptions   EventException[]
  reminders    Reminder[]

  @@index([familyId, startsAtUtc, endsAtUtc])
  @@index([familyId, status, startsAtUtc])
  @@index([responsibleMemberId])
  @@index([categoryId])
}

/// Исключение отдельной даты из серии (отмена одного вхождения)
model EventException {
  id                     String   @id @default(cuid())
  eventId                String
  occurrenceStartsAtUtc  DateTime
  createdAt              DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, occurrenceStartsAtUtc])
  @@index([eventId])
}

model EventParticipant {
  eventId  String
  memberId String

  event  Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([eventId, memberId])
  @@index([memberId])
}

/// Напоминание за N минут до старта (или ближайшего вхождения серии)
model Reminder {
  id            String    @id @default(cuid())
  eventId       String
  minutesBefore Int
  nextFireAt    DateTime?
  lastFiredAt   DateTime?
  /// Для повторяющихся: UTC старт вхождения, по которому уже сработало
  lastOccurrenceStartsAtUtc DateTime?
  createdAt     DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, minutesBefore])
  @@index([nextFireAt])
  @@index([eventId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  familyId  String?
  eventId   String?
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  /// JSON: reminderId, occurrenceStartsAtUtc, …
  meta      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Browser Web Push subscription (one device/browser per endpoint)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
