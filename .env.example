# Database
DATABASE_URL=postgresql://family:family@localhost:5433/family_calendar?schema=public

# API
API_PORT=3000
# NODE_ENV=production  # в prod обязательны сильный JWT_SECRET и CORS_ORIGIN
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
# Долгая «бессрочная» сессия для семьи (refresh); access всё равно короткий и обновляется сам
JWT_REFRESH_EXPIRES_DAYS=365
# legacy alias (если задан без JWT_ACCESS_EXPIRES_IN)
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
PASSWORD_RESET_EXPIRES_HOURS=2
# SMTP_URL=smtp://user:pass@smtp.example.com:587

# MinIO (Stage 2 — avatars/attachments)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=family-calendar

# Frontend
VITE_API_URL=http://localhost:3000

# Web Push (VAPID) — сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BNGZNNjO_F1QU2DiScBEI2AeYGL8C2fl5r2KX-PXZiaap3krDQM3mT5g8ldJ2Ng0sm6K-HCxBS00Ss_4UKhaEpI
